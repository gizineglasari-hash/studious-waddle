# ============================================
# Koniciwa Gemas Gempita - Environment Variables
# ============================================
# Salin file ini menjadi .env dan sesuaikan nilainya
# Untuk Vercel: tambahkan variable ini di Project Settings → Environment Variables

# =====================================================
# SUPABASE (WAJIB untuk multi-device login)
# =====================================================
# Buat project gratis di https://supabase.com
# Setelah buat project, copy URL dan anon key dari:
# Project Settings → API → Project URL & anon public key

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# =====================================================
# OPTIONAL - Vercel Analytics Dashboard URL
# =====================================================
# NEXT_PUBLIC_VERCEL_ANALYTICS_URL=https://vercel.com/your-team/your-project/analytics

# =====================================================
# TIDAK DIPERLUKAN SAAT INI
# =====================================================
# DATABASE_URL - tidak digunakan (pakai Supabase)
# NEXTAUTH_SECRET - tidak digunakan (pakai Supabase Auth)
# ZAI_API_KEY - tidak digunakan
